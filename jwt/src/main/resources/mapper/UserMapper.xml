<?xml version="1.0" encoding="utf-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tenco.class_jwt_v01.mapper.UserMapper">
    <!--
            2025.02.25 (화) - UserMapper XML 설정
            - save: 사용자 정보 저장
            - findByUsername: username으로 사용자 조회
            - updateRefreshToken: 리프레시 토큰 업데이트
        -->
    <insert id="save" parameterType="com.tenco.class_jwt_v01.domain.User"><!-- User 통으로 넣기로 함 -->
        <!-- User 객체 전체 저장 -->
        INSERT INTO users(username, password)
        VALUES (#{username}, #{password})
    </insert>

    <select id="findByUsername" resultType="com.tenco.class_jwt_v01.domain.User">
        <!-- username으로 사용자 조회 -->
         SELECT * FROM users WHERE username = #{username}
    </select>

    <!--  리프레시 토큰 업데이트 (update/delete 문 -> where 절 반드시 확인) -->
    <update id="updateRefreshToken" parameterType="com.tenco.class_jwt_v01.domain.User">
        UPDATE users SET refresh_token = #{refreshToken} WHERE username = #{username}
    </update>

</mapper>